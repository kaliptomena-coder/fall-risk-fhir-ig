  fhir:subject [
     fhir:l <https://example.org/fhir/fall-risk/Patient/example-patient> ;
     fhir:reference [ fhir:v "Patient/example-patient" ]
  ] ; # 
  fhir:authored [ fhir:v "2024-11-15T10:00:00+01:00"^^xsd:dateTime] ; # 
  fhir:item ( [
     fhir:linkId [ fhir:v "falls-count" ] ;
     fhir:text [ fhir:v "How many times have you fallen in the last 12 months?" ] ;
     fhir:answer ( [
       fhir:value [
         a fhir:Integer ;
         fhir:v 2
       ]
     ] )
  ] [
     fhir:linkId [ fhir:v "fear-of-falling" ] ;
     fhir:text [ fhir:v "Are you worried about falling? (ABC scale)" ] ;
     fhir:answer ( [
       fhir:value [
         a fhir:Coding, sct:373066001 ;
         fhir:system [
           fhir:v "http://snomed.info/sct"^^xsd:anyURI ;
           fhir:l <http://snomed.info/sct>
         ] ;
         fhir:code [ fhir:v "373066001" ] ;
         fhir:display [ fhir:v "Yes" ]
       ]
     ] )
  ] [
     fhir:linkId [ fhir:v "adl-independence" ] ;
     fhir:text [ fhir:v "Activities of Daily Living (ADL): functional independence" ] ;
     fhir:answer ( [
       fhir:value [
         a fhir:String ;
         fhir:v "Slight assistance needed"
       ]
     ] )
  ] [
     fhir:linkId [ fhir:v "walking-ability" ] ;
     fhir:text [ fhir:v "Walking ability and use of walking aids" ] ;
     fhir:answer ( [
       fhir:value [
         a fhir:String ;
         fhir:v "With aids"
       ]
     ] )
  ] [
     fhir:linkId [ fhir:v "alcohol-use" ] ;
     fhir:text [ fhir:v "Alcohol use (units per week)" ] ;
     fhir:answer ( [
       fhir:value [
         a fhir:Quantity ;
         fhir:value [ fhir:v "2"^^xsd:decimal ] ;
         fhir:unit [ fhir:v "units/week" ] ;
         fhir:system [
           fhir:v "http://unitsofmeasure.org"^^xsd:anyURI ;
           fhir:l <http://unitsofmeasure.org>
         ] ;
         fhir:code [ fhir:v "/wk" ]
       ]
     ] )
  ] [
     fhir:linkId [ fhir:v "physical-activity" ] ;
     fhir:text [ fhir:v "Current physical activity level" ] ;
     fhir:answer ( [
       fhir:value [
         a fhir:String ;
         fhir:v "Low activity"
       ]
     ] )
  ] [
     fhir:linkId [ fhir:v "tug-score" ] ;
     fhir:text [ fhir:v "Timed Up & Go test result (seconds)" ] ;
     fhir:answer ( [
       fhir:value [
         a fhir:Decimal ;
         fhir:v 14.2
       ]
     ] )
  ] [
     fhir:linkId [ fhir:v "chair-stand-score" ] ;
     fhir:text [ fhir:v "Sit to stand frequency in 30 seconds (repetitions)" ] ;
     fhir:answer ( [
       fhir:value [
         a fhir:Integer ;
         fhir:v 8
       ]
     ] )
  ] [
     fhir:linkId [ fhir:v "balance-4stage" ] ;
     fhir:text [ fhir:v "4-Stage Balance Test result (highest stage reached)" ] ;
     fhir:answer ( [
       fhir:value [
         a fhir:Integer ;
         fhir:v 3
       ]
     ] )
  ] [
     fhir:linkId [ fhir:v "ehr-fallback-group" ] ;
     fhir:text [ fhir:v "Clinical History Data (EHR-derived)" ] ;
     fhir:item ( [
       fhir:linkId [ fhir:v "medications" ] ;
       fhir:text [ fhir:v "Total medication count (including FRIDs flag)" ] ;
       fhir:answer ( [
         fhir:value [
           a fhir:String ;
           fhir:v "3:FRID"
         ]
       ] )
     ] [
       fhir:linkId [ fhir:v "comorbidities" ] ;
       fhir:text [ fhir:v "Number of active diagnoses (comorbidities)" ] ;
       fhir:answer ( [
         fhir:value [
           a fhir:Integer ;
           fhir:v 3
         ]
       ] )
     ] [
       fhir:linkId [ fhir:v "cognitive-status" ] ;
       fhir:text [ fhir:v "MMSE score" ] ;
       fhir:answer ( [
         fhir:value [
           a fhir:Integer ;
           fhir:v 24
         ]
       ] )
     ] [
       fhir:linkId [ fhir:v "vision-impairment" ] ;
       fhir:text [ fhir:v "Vision or hearing impairment present?" ] ;
       fhir:answer ( [
         fhir:value [
           a fhir:Boolean ;
           fhir:v true
         ]
       ] )
     ] )
  ] ) . # 

